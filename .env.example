# Directory where bd will run from (must contain a .beads/ database or a git repo with one)
PROJECT_DIR=/path/to/your/project

# Optional: explicit path to .beads/ directory (alternative to PROJECT_DIR)
# BEADS_DIR=/path/to/your/project/.beads

# Optional: custom path to bd binary (default: ~/.local/bin/bd)
# BD_PATH=/usr/local/bin/bd

# API server port (default: 3001)
# PORT=3001
